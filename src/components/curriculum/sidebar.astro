---
import type {
  Information,
  Language as LanguageType,
  Social,
} from '../../types';

import { Image } from 'astro:assets';

import Language from '../curriculum/language.astro';

import emailIcon from '../../assets/icons/email.svg?raw';
import mapPinIcon from '../../assets/icons/map-pin.svg?raw';
import profile from '../../assets/profile.png';

interface Props {
  information: Information;
  socials: Social[];
  languages: LanguageType[];
  competences: string[];
}

const { information, socials, languages, competences } = Astro.props;
---

<aside
  class='w-full space-y-6 rounded-2xl border border-gray-200 bg-gray-200 p-6 lg:w-80 lg:shrink-0 dark:border-gray-800 dark:bg-gray-900 print:min-h-screen print:rounded-none print:border-0 print:p-4 print:text-sm'
>
  <div
    class='flex flex-col items-center gap-4 md:flex-row lg:flex-col print:flex-col print:md:flex-col'
  >
    <Image
      src={profile}
      alt={`Foto de perfil de ${information.full_name}`}
      height={240}
      width={240}
      class='h-48 w-48 rounded-full bg-gray-100 object-cover object-top shadow-lg ring-4 ring-white md:h-56 md:w-56 lg:h-60 lg:w-60 dark:bg-gray-800 dark:ring-gray-950 print:h-32 print:w-32'
    />

    <div class='min-w-0 space-y-4 text-center'>
      <div class='space-y-1'>
        <h1
          class='break-words text-xl font-bold leading-tight text-gray-900 dark:text-white print:text-base'
        >
          {information.full_name}
        </h1>
        <p class='text-sm text-gray-700 dark:text-gray-300 print:text-xs'>
          {information.profession}
        </p>
      </div>

      <div
        class='flex flex-wrap justify-center gap-3 [&_svg]:h-5 [&_svg]:w-5 [&_svg]:fill-current print:[&_svg]:h-4 print:[&_svg]:w-4'
      >
        {
          socials
            .filter((s) => s.name !== 'Email')
            .map((s) => (
              <a
                href={s.url}
                title={s.name}
                aria-label={s.name}
                class='text-gray-700 transition hover:text-blue-700 dark:text-gray-300 dark:hover:text-blue-400'
                target='_blank'
                rel='noopener noreferrer'
              >
                <Fragment
                  set:html={import(`../../assets/icons/${s.icon}.svg?raw`).then(
                    (i) => i.default
                  )}
                />
              </a>
            ))
        }
      </div>

      <div
        class='space-y-2 text-sm text-gray-700 dark:text-gray-300 [&_svg]:h-4 [&_svg]:w-4 [&_svg]:fill-current print:text-xs print:[&_svg]:h-3 print:[&_svg]:w-3'
      >
        <a
          href={`mailto:${information.email}`}
          class='flex items-center justify-center gap-2 break-words transition hover:text-blue-700 dark:hover:text-blue-400'
          aria-label={`Enviar correo a ${information.email}`}
        >
          <Fragment set:html={emailIcon} />
          {information.email}
        </a>
        <p class='flex items-center justify-center gap-2'>
          <Fragment set:html={mapPinIcon} />
          {information.city}, {information.country}
        </p>
      </div>
    </div>
  </div>

  <article>
    <h2
      class='mb-2 border-b border-b-gray-400 pb-1 font-semibold text-gray-900 dark:border-b-gray-700 dark:text-white'
    >
      Idiomas
    </h2>
    <ul class='mt-3 space-y-4 text-sm print:text-xs'>
      {languages.map((language) => <Language language={language} />)}
    </ul>
  </article>

  <article>
    <h2
      class='mb-2 border-b border-b-gray-400 pb-1 font-semibold text-gray-900 dark:border-b-gray-700 dark:text-white'
    >
      Aptitudes
    </h2>
    <ul class='mt-3 space-y-1 text-sm text-gray-700 dark:text-gray-300 print:text-xs'>
      {competences.map((competence) => <li>{competence}</li>)}
    </ul>
  </article>
</aside>
