---
import type { Education } from '../../types';
import dayjs from 'dayjs';
import 'dayjs/locale/es-mx';

interface Props {
  education: Education;
}

const { education } = Astro.props;

dayjs.locale('es-mx');

const isCurrent = !education.end_date;
---

<div class='flex flex-col'>
  <div
    class='mb-1 flex flex-wrap gap-2 text-sm font-normal leading-none text-gray-500 dark:text-gray-400 print:mb-0 print:text-xs'
  >
    <time>{dayjs(education.start_date).format('MMMM, YYYY')}</time>
    {
      education.end_date && (
        <>
          <span aria-hidden='true'>-</span>
          <time>{dayjs(education.end_date).format('MMMM, YYYY')}</time>
        </>
      )
    }
  </div>

  <h3
    class='mb-1 flex flex-wrap items-center gap-2 text-lg font-semibold text-gray-900 dark:text-white print:mb-0 print:text-sm'
  >
    <span class='break-words'>{education.goal}</span>
    {
      isCurrent && (
        <span class='rounded bg-blue-100 px-2.5 py-0.5 text-sm font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300'>
          Actual
        </span>
      )
    }
  </h3>

  <div
    class='flex flex-col text-sm font-normal leading-snug sm:flex-row sm:items-center print:text-xs'
  >
    <span class='font-medium text-gray-700 dark:text-gray-300'
      >{education.institution}</span
    >
    <span
      class='text-gray-500 sm:ml-2 sm:border-l sm:border-l-gray-400 sm:pl-2 dark:border-l-gray-600 dark:text-gray-400'
      >{education.city}, {education.country}</span
    >
  </div>
</div>
