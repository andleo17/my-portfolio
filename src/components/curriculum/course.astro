---
import type { Course } from '../../types';

import dayjs from 'dayjs';

interface Props {
  course: Course;
}

const { course } = Astro.props;

const certificationUrl = course.certification_url;
const year = dayjs(course.end_date ?? course.start_date).format('YYYY');
---

<li
  class='break-inside-avoid text-sm text-gray-600 dark:text-gray-400 print:text-[10.5pt] print:text-black'
>
  {
    certificationUrl ? (
      <a
        href={certificationUrl}
        target='_blank'
        rel='noopener noreferrer'
        class='font-medium text-gray-900 underline decoration-gray-400 underline-offset-2 transition hover:text-blue-700 hover:decoration-blue-600 dark:text-gray-100 dark:hover:text-blue-400 dark:hover:decoration-blue-400 print:text-black print:no-underline'
      >
        {course.name}
      </a>
    ) : (
      <span class='font-medium text-gray-900 dark:text-gray-100 print:text-black'>
        {course.name}
      </span>
    )
  }
  <span> — {course.institution}, {year}</span>
</li>
