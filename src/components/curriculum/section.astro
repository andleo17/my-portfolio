---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article>
  <h2
    class='mb-3 border-b border-b-gray-400 pb-1 text-lg font-bold uppercase tracking-wide text-gray-900 dark:border-b-gray-700 dark:text-white print:mb-2 print:text-sm'
  >
    {title}
  </h2>
  <slot />
</article>
