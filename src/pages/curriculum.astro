---
import data from '../../data.json';
import type { Skill } from '../types';

import Layout from '../layouts/default.astro';

import WorkExperience from '../components/curriculum/experience.astro';
import Education from '../components/curriculum/education.astro';
import Course from '../components/curriculum/course.astro';
import CurriculumSection from '../components/curriculum/section.astro';

const linkedin = data.socials.find((social) => social.name === 'LinkedIn');
const github = data.socials.find((social) => social.name === 'GitHub');

const contactItems = [
  {
    label: data.information.email,
    href: `mailto:${data.information.email}`,
    external: false,
  },
  ...(linkedin
    ? [{ label: 'LinkedIn', href: linkedin.url, external: true }]
    : []),
  ...(github ? [{ label: 'GitHub', href: github.url, external: true }] : []),
  {
    label: `${data.information.city}, ${data.information.country}`,
    href: undefined,
    external: false,
  },
];

const workExperience = [...data.work_experience].sort((a, b) =>
  b.start_date.localeCompare(a.start_date)
);

const education = [...data.education].sort((a, b) =>
  b.start_date.localeCompare(a.start_date)
);

const courses = [...data.courses].sort((a, b) =>
  (b.end_date ?? b.start_date).localeCompare(a.end_date ?? a.start_date)
);

const profile =
  data.information.description
    .match(/[^.!?]+[.!?]+/g)
    ?.slice(0, 2)
    .join(' ')
    .trim() ?? data.information.description;

const skillGroups: { title: string; groups: Record<string, Skill[]> }[] = [
  { title: 'Backend', groups: data.skills.backend },
  { title: 'Frontend', groups: data.skills.frontend },
  { title: 'Calidad', groups: data.skills.quality },
  { title: 'Extras', groups: data.skills.others },
];

const languagesLine = data.languages
  .map(
    (language) =>
      `${language.name} — ${
        language.level === 'native' ? 'nativo' : language.level
      }`
  )
  .join(' · ');
---

<Layout
  title={`Curriculum — ${data.information.short_name}`}
  description={`${data.information.profession}. ${data.information.short_description}`}
>
  <main
    class='mx-auto max-w-4xl px-4 py-8 text-gray-900 sm:px-6 lg:py-12 dark:text-gray-100 print:max-w-none print:px-0 print:py-0 print:text-[10.5pt]'
  >
    <div class='mb-6 flex justify-end print:hidden'>
      <button
        id='download-pdf'
        type='button'
        class='inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-800 shadow-sm transition hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:bg-gray-800 print:hidden'
      >
        Descargar PDF
      </button>
    </div>

    <header
      class='border-b border-gray-300 pb-4 dark:border-gray-700 print:border-gray-400 print:pb-3'
    >
      <h1
        class='text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white print:text-[20pt] print:leading-tight print:text-black'
      >
        {data.information.full_name}
      </h1>
      <p
        class='mt-1 text-base font-medium text-gray-700 dark:text-gray-300 print:text-[11pt] print:text-black'
      >
        {data.information.profession}
      </p>

      <ul
        class='mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-600 dark:text-gray-400 print:text-[10.5pt] print:text-black'
      >
        {
          contactItems.map((item, index) => (
            <>
              {index > 0 && (
                <li
                  aria-hidden='true'
                  class='text-gray-400 dark:text-gray-600 print:text-black'
                >
                  ·
                </li>
              )}
              <li>
                {item.href ? (
                  <a
                    href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                    class='underline decoration-gray-400 underline-offset-2 transition hover:text-blue-700 hover:decoration-blue-600 dark:hover:text-blue-400 dark:hover:decoration-blue-400 print:no-underline'
                  >
                    {item.label}
                  </a>
                ) : (
                  <span>{item.label}</span>
                )}
              </li>
            </>
          ))
        }
      </ul>
    </header>

    <div class='mt-6 space-y-6 print:mt-4 print:space-y-4'>
      <CurriculumSection title='Perfil'>
        <p
          class='text-sm leading-relaxed text-gray-600 dark:text-gray-300 print:text-[10.5pt] print:leading-snug print:text-black'
        >
          {profile}
        </p>
      </CurriculumSection>

      <CurriculumSection title='Experiencia laboral'>
        <ol class='space-y-4 print:space-y-3'>
          {
            workExperience.map((experience) => (
              <WorkExperience data={experience} />
            ))
          }
        </ol>
      </CurriculumSection>

      <CurriculumSection title='Formación'>
        <div class='space-y-3 print:space-y-2'>
          {education.map((item) => <Education education={item} />)}
        </div>
      </CurriculumSection>

      <CurriculumSection title='Certificaciones y cursos'>
        <ul class='space-y-1'>
          {courses.map((course) => <Course course={course} />)}
        </ul>
      </CurriculumSection>

      <CurriculumSection title='Conocimientos'>
        <div class='space-y-3 print:space-y-2'>
          {
            skillGroups.map((group) => (
              <section class='break-inside-avoid'>
                <h3 class='mb-1 text-sm font-semibold text-gray-900 dark:text-white print:text-black'>
                  {group.title}
                </h3>
                <div class='space-y-1 text-sm text-gray-600 dark:text-gray-300 print:text-[10.5pt] print:text-black'>
                  {Object.entries(group.groups).map(([name, skills]) => (
                    <p>
                      <span class='font-medium text-gray-800 dark:text-gray-200 print:text-black'>
                        {name}:
                      </span>{' '}
                      {[...skills]
                        .sort((first, second) => second.level - first.level)
                        .map((skill) => skill.name)
                        .join(', ')}
                    </p>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </CurriculumSection>

      <CurriculumSection title='Idiomas'>
        <p
          class='text-sm text-gray-700 dark:text-gray-300 print:text-[10.5pt] print:text-black'
        >
          {languagesLine}
        </p>
      </CurriculumSection>
    </div>
  </main>
</Layout>

<style is:global>
  @page {
    size: A4;
    margin: 14mm 16mm;
  }

  @media print {
    html,
    body {
      background: #fff !important;
      color: #000 !important;
    }

    body {
      font-size: 10.5pt;
      line-height: 1.35;
    }

    body * {
      color: #000 !important;
      box-shadow: none !important;
      text-shadow: none !important;
    }

    a {
      color: #000 !important;
      text-decoration: none !important;
    }

    nav,
    footer {
      display: none !important;
    }

    .break-inside-avoid {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    h1,
    h2,
    h3 {
      break-after: avoid;
      page-break-after: avoid;
    }
  }
</style>

<script>
  const downloadButton = document.getElementById('download-pdf');

  downloadButton?.addEventListener('click', () => {
    const root = document.documentElement;
    const wasDark = root.classList.contains('dark');

    if (wasDark) root.classList.remove('dark');
    window.print();
    if (wasDark) root.classList.add('dark');
  });
</script>
