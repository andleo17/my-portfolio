---
import type { WorkExperience } from '../types';

import dayjs from 'dayjs';
import 'dayjs/locale/es-mx';

interface Props {
  data: WorkExperience;
  showIcons?: boolean;
}

const { data, showIcons = false } = Astro.props;

dayjs.locale('es-mx');

const isCurrent = !data.end_date;
---

<li class:list={['relative min-w-0', showIcons ? 'ml-6' : '']}>
  {
    showIcons && (
      <span class='absolute -left-9 top-0 flex h-6 w-6 items-center justify-center rounded-full bg-blue-100 ring-8 ring-gray-50 dark:bg-blue-900 dark:ring-gray-950 print:hidden'>
        <i
          class='text-blue-800 dark:text-blue-300 [&>*]:h-4 [&>*]:w-4 [&>*]:fill-current'
          aria-hidden='true'
        >
          <Fragment
            set:html={import(`../assets/icons/${data.icon}.svg?raw`).then(
              (i) => i.default
            )}
          />
        </i>
      </span>
    )
  }

  <div
    class='mb-1 flex flex-wrap gap-2 text-sm font-normal leading-none text-gray-500 dark:text-gray-400 print:mb-0 print:text-xs'
  >
    <time>{dayjs(data.start_date).format('MMMM, YYYY')}</time>
    {
      data.end_date && (
        <>
          <span aria-hidden='true'>-</span>
          <time>{dayjs(data.end_date).format('MMMM, YYYY')}</time>
        </>
      )
    }
  </div>

  <h3
    class='mb-1 flex flex-wrap items-center gap-2 text-lg font-semibold text-gray-900 dark:text-white print:mb-0 print:text-base'
  >
    <span class='break-words'>{data.title}</span>
    {
      isCurrent && (
        <span class='rounded bg-blue-100 px-2.5 py-0.5 text-sm font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300'>
          Actual
        </span>
      )
    }
  </h3>

  <div
    class='flex flex-col text-sm font-normal leading-snug sm:flex-row sm:items-center print:text-xs'
  >
    <span class='font-medium text-gray-700 dark:text-gray-300'
      >{data.institution}</span
    >
    <span
      class='text-gray-500 sm:ml-2 sm:border-l sm:border-l-gray-400 sm:pl-2 dark:border-l-gray-600 dark:text-gray-400'
      >{data.city}, {data.country}</span
    >
  </div>

  <ul
    class='mt-4 list-disc space-y-1 pl-5 text-sm font-normal text-gray-600 marker:text-gray-400 dark:text-gray-300 print:mt-2 print:space-y-0 print:text-sm'
  >
    {data.goals.map((goal) => <li class='break-words'>{goal}</li>)}
  </ul>
</li>
