---
import type { Education } from '../../types';

import dayjs from 'dayjs';
import 'dayjs/locale/es';

interface Props {
  education: Education;
}

const { education } = Astro.props;

dayjs.locale('es');

const startDate = dayjs(education.start_date).format('MMM YYYY');
const endDate = education.end_date
  ? dayjs(education.end_date).format('MMM YYYY')
  : 'presente';
const dateRange = `${startDate} – ${endDate}`;
---

<div class='break-inside-avoid'>
  <div class='flex items-baseline justify-between gap-3'>
    <h3
      class='font-semibold text-gray-900 dark:text-white print:text-black'
    >
      {education.institution}
    </h3>
    <time
      class='shrink-0 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400 print:text-[10.5pt] print:text-black'
    >
      {dateRange}
    </time>
  </div>

  <p class='text-sm text-gray-700 dark:text-gray-300 print:text-black'>
    {education.goal}
  </p>
  <p class='text-sm text-gray-500 dark:text-gray-400 print:text-black'>
    {education.city}, {education.country}
  </p>
</div>
