---
import type { Skill as SkillType } from '../types';

import Skill from './skill.astro';

interface Props {
  skills: SkillType[];
  name: string;
}

const { skills, name } = Astro.props;
---

<div
  class='min-w-0 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900'
>
  <div class='flex flex-wrap items-stretch justify-center gap-2 p-3'>
    {
      [...skills]
        .sort((s1, s2) => s2.level - s1.level)
        .map((s) => <Skill data={s} />)
    }
  </div>
  <div
    class='border-t border-gray-200 bg-gray-50 px-3 py-2 text-center text-[11px] font-semibold uppercase tracking-wide text-gray-500 dark:border-gray-800 dark:bg-gray-950/60 dark:text-gray-400'
  >
    {name}
  </div>
</div>
