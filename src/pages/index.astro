---
import data from '../../data.json';
import type { Skill } from '../types';

import Layout from '../layouts/default.astro';

import Hero from '../components/hero.astro';
import SkillGroup from '../components/skill-group.astro';
import Project from '../components/project.astro';
import WorkExperience from '../components/work-experience.astro';

const currentJob = data.work_experience.find((job) => !job.end_date);

const sameAs = data.socials
  .filter((social) => ['LinkedIn', 'GitHub'].includes(social.name))
  .map((social) => social.url);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: data.information.full_name,
  jobTitle: currentJob?.title ?? data.information.profession,
  url: 'https://andleo.dev',
  image: 'https://andleo.dev/images/profile.jpg',
  email: `mailto:${data.information.email}`,
  sameAs,
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name:
      data.education[0]?.institution ??
      'Universidad Católica Santo Toribio de Mogrovejo',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: data.information.city,
    addressCountry: data.information.country,
  },
};

const skillGroups: { title: string; groups: Record<string, Skill[]> }[] = [
  { title: 'Backend', groups: data.skills.backend },
  { title: 'Frontend', groups: data.skills.frontend },
  { title: 'Calidad', groups: data.skills.quality },
  { title: 'Extras', groups: data.skills.others },
];
---

<Layout jsonLd={personSchema}>
  <main>
    <Hero
      data={data.information}
      socials={data.socials}
      currentRole={currentJob?.title}
      currentCompany={currentJob?.institution}
    />

    <section
      id='work-experience'
      class='scroll-mt-20 border-t border-gray-200 dark:border-gray-800'
    >
      <div class='mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8'>
        <h2
          class='text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl'
        >
          Experiencia laboral
        </h2>
        <ol
          class='relative ml-7 mt-10 space-y-10 border-l border-gray-300 sm:ml-8 dark:border-gray-800'
        >
          {
            data.work_experience.map((we) => (
              <WorkExperience data={we} showIcons />
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id='projects'
      class='scroll-mt-20 border-t border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900/40'
    >
      <div class='mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8'>
        <h2
          class='text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl'
        >
          Proyectos
        </h2>
        <div
          class='mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3'
        >
          {data.projects.map((p) => <Project data={p} />)}
        </div>
      </div>
    </section>

    <section
      id='skills'
      class='scroll-mt-20 border-t border-gray-200 dark:border-gray-800'
    >
      <div class='mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8'>
        <h2
          class='text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl'
        >
          Conocimientos
        </h2>
        <div class='mt-10 grid gap-6 sm:grid-cols-2'>
          {
            skillGroups.map((group) => (
              <section class='min-w-0'>
                <h3 class='mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400'>
                  {group.title}
                </h3>
                <div class='space-y-3'>
                  {Object.entries(group.groups).map(([name, skills]) => (
                    <SkillGroup name={name} skills={skills} />
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
