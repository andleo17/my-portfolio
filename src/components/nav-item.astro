---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<li>
  <a
    href={href}
    class='block rounded-md px-3 py-2 text-gray-700 transition hover:bg-gray-100 hover:text-blue-700 md:px-3 md:py-2 md:hover:bg-blue-50 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400 md:dark:hover:bg-gray-900'
    >{label}</a
  >
</li>
