---
import NavItem from './nav-item.astro';
import ToggleThemeButton from './toggle-theme-button.astro';
---

<nav
  class='sticky top-0 z-50 border-b border-gray-200/80 bg-gray-50/90 backdrop-blur dark:border-gray-800 dark:bg-gray-950/90 print:hidden'
  aria-label='Navegación principal'
>
  <div
    class='mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8'
  >
    <a
      href='/'
      class='select-none text-2xl font-bold tracking-tight text-gray-900 transition hover:text-blue-700 dark:text-white dark:hover:text-blue-400'
      aria-label='Ir al inicio'
    >
      andleo<span class='text-blue-700 dark:text-blue-400'>.</span>
    </a>

    <div class='flex items-center gap-2 md:order-2'>
      <ToggleThemeButton />
      <button
        id='navbar-toggle'
        type='button'
        class='inline-flex h-10 w-10 items-center justify-center rounded-lg p-2 text-sm text-gray-600 transition hover:bg-gray-200 focus:ring-4 focus:ring-gray-200 md:hidden dark:text-gray-300 dark:hover:bg-gray-800 dark:focus:ring-gray-700'
        aria-controls='navbar'
        aria-expanded='false'
        aria-label='Abrir menú de navegación'
      >
        <svg
          class='h-5 w-5'
          aria-hidden='true'
          xmlns='http://www.w3.org/2000/svg'
          fill='none'
          viewBox='0 0 17 14'
        >
          <path
            stroke='currentColor'
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M1 1h15M1 7h15M1 13h15'></path>
        </svg>
      </button>
    </div>

    <div
      id='navbar'
      class='hidden w-full md:order-1 md:flex md:w-auto md:items-center'
    >
      <ul
        class='mt-3 flex flex-col gap-1 rounded-lg border border-gray-200 bg-white p-2 font-medium shadow-sm md:mt-0 md:flex-row md:items-center md:gap-1 md:border-0 md:bg-transparent md:p-0 md:shadow-none dark:border-gray-800 dark:bg-gray-900 md:dark:bg-transparent'
      >
        <NavItem href='/#work-experience' label='Experiencia laboral' />
        <NavItem href='/#projects' label='Proyectos' />
        <NavItem href='/#skills' label='Conocimientos' />
        <NavItem href='/curriculum' label='Curriculum' />
      </ul>
    </div>
  </div>
</nav>

<script>
  const navbarToggle = document.getElementById('navbar-toggle');
  const navbar = document.getElementById('navbar');

  if (navbarToggle && navbar) {
    navbarToggle.addEventListener('click', () => {
      const isExpanded = navbarToggle.getAttribute('aria-expanded') === 'true';

      navbarToggle.setAttribute('aria-expanded', String(!isExpanded));
      navbarToggle.setAttribute(
        'aria-label',
        isExpanded ? 'Abrir menú de navegación' : 'Cerrar menú de navegación'
      );
      navbar.classList.toggle('hidden');
    });

    navbar.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 768) {
          navbar.classList.add('hidden');
          navbarToggle.setAttribute('aria-expanded', 'false');
          navbarToggle.setAttribute('aria-label', 'Abrir menú de navegación');
        }
      });
    });
  }
</script>
